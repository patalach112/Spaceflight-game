# The manifest is generated by CMake for the current target/configuration.
# Read paths and DLL lists as data, not as cmd.exe/sh command-line fragments.
if(NOT DEFINED MANIFEST OR NOT EXISTS "${MANIFEST}")
  message(FATAL_ERROR "Runtime copy manifest not found: ${MANIFEST}")
endif()
include("${MANIFEST}")
if(NOT EXISTS "${AEGIS_ENGINE}")
  message(FATAL_ERROR "Engine library not found: ${AEGIS_ENGINE}")
endif()

foreach(destination IN LISTS AEGIS_DESTINATIONS)
  file(MAKE_DIRECTORY "${destination}")
  get_filename_component(engine_name "${AEGIS_ENGINE}" NAME)
  file(COPY_FILE "${AEGIS_ENGINE}" "${destination}/${engine_name}" ONLY_IF_DIFFERENT)
  foreach(dll IN LISTS AEGIS_DLLS)
    if(NOT EXISTS "${dll}")
      message(FATAL_ERROR "Runtime dependency not found: ${dll}")
    endif()
    get_filename_component(dll_name "${dll}" NAME)
    file(COPY_FILE "${dll}" "${destination}/${dll_name}" ONLY_IF_DIFFERENT)
  endforeach()
  if(DEFINED AEGIS_FONT)
    file(MAKE_DIRECTORY "${destination}/assets")
    file(COPY_FILE "${AEGIS_FONT}" "${destination}/assets/DejaVuSans.ttf" ONLY_IF_DIFFERENT)
  endif()
endforeach()
